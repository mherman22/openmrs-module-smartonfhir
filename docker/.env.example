# Copy to .env and adjust. All values have working defaults; nothing here is required.

# Image pins. Keycloak is pinned deliberately: the provider implements internal
# Keycloak SPIs, so a minor upgrade can break it without a deprecation cycle.
REFAPP_TAG=3.7.1
KEYCLOAK_TAG=26.7.1

# Host ports. OPENMRS_PORT=80 gives http://localhost/openmrs, which is what the
# realm is rendered with by default.
OPENMRS_PORT=80
KEYCLOAK_PORT=8180

# Keycloak development admin.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# OpenMRS database credentials.
OMRS_DB_USER=openmrs
OMRS_DB_PASSWORD=openmrs
MYSQL_ROOT_PASSWORD=openmrs

# Where the Keycloak SPI is checked out. Defaults to a sibling of this repository.
#SMART_AUTH_REPO=../../openmrs-contrib-keycloak-smart-auth

# A JDK 17+ for building the Keycloak provider, if your default java is older.
#SMART_JAVA_HOME=/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home
